# CATALYST (PRAVAHA) Environment Configuration Template
# Copy this file to .env.local or .env for local overrides if needed.
# Note: The core client prototype currently runs purely in-browser with localStorage persistence.
# These variables are optional placeholders for planned external service integrations.

# Development Server Port (Vite default is 5173)
VITE_PORT=5173

# Future / Planned Backend Integration (Supabase / PostgreSQL)
# Leave blank during offline / local mock demonstration mode
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-placeholder
